<style
  name="birthday"
  source="ui/zh_cn/swf/birthday.swf">
  <sets>
    <set
      type="flash.text.TextFormat"
      stylename="birthday.messageTF"
      args="Arial,12,0xffde00,,,,,,left" />
    <set
      type="flash.text.TextFormat"
      stylename="birthday.playerNameTF"
      args="Arial,12,0xe4d29c,,,,,,right" />
    <set
      type="flash.text.TextFormat"
      stylename="birthday.inputTF"
      args="Arial,12,0xecdfa1,,,,,,left" />
    <set
      type="flash.text.TextFormat"
      stylename="birthday.inputTipTF"
      args="Arial,12,0xffffff,,,,,,right" />
  </sets>
  <bitmaps>
    <!-- 祝福语显示框 -->
    <bitmapData
      resourceLink="asset.birthday.boardTitle"
      x="400"
      y="20" />
    <bitmapData
      resourceLink="asset.birthday.boardBg" />
    <bitmapData
      resourceLink="asset.birthday.smallBtnBg" />
    <bitmapData
      resourceLink="asset.birthday.refreshBtn" />
    <bitmapData
      resourceLink="asset.birthday.wishBtn" />
    <bitmapData
      resourceLink="asset.birthday.getBuffBtn" />
    <bitmapData
      resourceLink="asset.birthday.bigBtnBg" />
    <!-- 祝福语输入框 -->
    <bitmapData
      resourceLink="asset.birthday.wishTitle"
      y="70" />
    <bitmapData
      resourceLink="asset.birthday.submitBtn" />
    <bitmapData
      resourceLink="asset.birthday.inputBg" />
    <bitmapData
      resourceLink="asset.birthday.inputTitle"
      x="150"
      y="-10" />
    <bitmapData
      resourceLink="asset.birthday.cancelBtn" />
    <bitmapData
      resourceLink="asset.birthday.btnBg" />
    <bitmapData
      resourceLink="asset.birthday.inputGg" />
  </bitmaps>
  <customDisplay>
    <custom
      classname="asset.birthday.recordPosMc"
      stylename="asset.birthday.recordPosMc" />
  </customDisplay>
  <components>
    <!-- 文本框 -->
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="birthday.messageText"
      textFormatStyle="birthday.messageTF"
      filterString="core.normal_f"
      autoSize="none"
      width="150"
      height="80" />
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="birthday.playerNameText"
      textFormatStyle="birthday.playerNameTF"
      filterString="core.normal_f"
      autoSize="none" />
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="birthday.inputText"
      textFormatStyle="birthday.inputTF"
      filterString="core.normal_f"
      autoSize="none"
      width="423"
      height="75"
      x="130"
      y="100" />
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="birthday.inputTipText"
      textFormatStyle="birthday.inputTipTF"
      filterString="core.normal_f"
      autoSize="none" />
    <!-- 按钮 -->
    <component
      classname="com.pickgliss.ui.controls.IconButton"
      stylename="birthday.wishBtn"
      backStyle="asset.birthday.bigBtnBg"
      iconStyle="asset.birthday.wishBtn"
      iconInnerRectString="30,106,13,24,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter"
      x="260"
      y="490" />
    <component
      classname="com.pickgliss.ui.controls.IconButton"
      stylename="birthday.getBuffBtn"
      backStyle="asset.birthday.bigBtnBg"
      iconStyle="asset.birthday.getBuffBtn"
      iconInnerRectString="21,127,13,24,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter" />
    <component
      classname="com.pickgliss.ui.controls.IconButton"
      stylename="birthday.refreshBtn"
      backStyle="asset.birthday.smallBtnBg"
      iconStyle="asset.birthday.refreshBtn"
      iconInnerRectString="17,36,6,16,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter"
      y="500" />
    <component
      classname="com.pickgliss.ui.controls.IconButton"
      stylename="birthday.submitBtn"
      backStyle="asset.birthday.btnBg"
      iconStyle="asset.birthday.submitBtn"
      iconInnerRectString="35,65,13,24,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter"
      x="180"
      y="210" />
    <component
      classname="com.pickgliss.ui.controls.IconButton"
      stylename="birthday.cancelBtn"
      backStyle="asset.birthday.btnBg"
      iconStyle="asset.birthday.cancelBtn"
      iconInnerRectString="35,65,13,24,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter" />
    <!-- 窗体 -->
    <component
      classname="com.pickgliss.ui.image.MutipleImage"
      stylename="birthdayBoard.Frame"
      resourceLink="asset.birthday.boardBg" />
    <component
      classname="birthday.BirthdayBoardFrame"
      stylename="birthday.BirthdayBoardFrame"
      closestyle="core.CloseBtn"
      titleStyle="core.FrameTitleText"
      backStyle="birthdayBoard.Frame"
      closeInnerRectString="29,32,42,29,14"
      moveInnerRectString="0,15,15,25,1"
      titleOuterRectPosString="0,13,1"
      moveEnable="true"
      enterEnable="true"
      escEnable="true"
      width="976"
      height="586" />
    <component
      classname="com.pickgliss.ui.image.MutipleImage"
      stylename="birthdayInput.Frame"
      resourceLink="asset.birthday.inputBg" />
    <component
      classname="birthday.BirthdayInputFrame"
      stylename="birthday.BirthdayInputFrame"
      closestyle="core.CloseBtn"
      titleStyle="core.FrameTitleText"
      backStyle="birthdayInput.Frame"
      closeInnerRectString="29,32,18,29,14"
      moveInnerRectString="0,15,15,25,1"
      titleOuterRectPosString="0,13,1"
      moveEnable="true"
      enterEnable="true"
      escEnable="true"
      width="674"
      height="306" />
  </components>
</style>