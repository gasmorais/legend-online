<style
  name="toptoolbar"
  source="ui/zh_cn/swf/toptoolbar.swf">
  <sets>
    <set
      type="flash.text.TextFormat"
      stylename="alchemyBtn.TotalNumTxt_f"
      args="Arial,12,0xffffff,,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="onlinereward.timeText_t1"
      args="Arial,12,0x00eef7,true,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="onlinereward.timeText_t2"
      args="Arial,12,0x13e827,true,,,,,center" />
    <!-- 目标选择面板 -->
    <set
      type="flash.text.TextFormat"
      stylename="toptoolbar.levelText_t"
      args="Arial,12,0xf6e80f,true,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="toptoolbar.nickNameText_t"
      args="Arial,14,0xffde00,,,,,,center" />
