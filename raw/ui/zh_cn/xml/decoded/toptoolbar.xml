  <bitmaps>
    <!-- 目标选择背景 -->
    <bitmapData
      resourceLink="asset.toptoolbar.TargetSelectBack"
      y="8" />
    <!-- 头像遮罩 -->
    <bitmapData
      resourceLink="asset.toptoolbar.TargetSelectMask" />
    <bitmapData
      resourceLink="asset.toptoolbar.alchemySoul.numberBg"
      x="7"
      y="9" />
  </bitmaps>
  <customDisplay>
    <custom
      classname="com.pickgliss.ui.controls.container.SimpleTileList"
      stylename="toptoolbar.Container1"
      vSpace="0"
      hSpace="0" />
    <custom
      classname="com.pickgliss.ui.controls.container.SimpleTileList"
      stylename="toptoolbar.Container2"
      vSpace="-2"
      hSpace="-4"
      y="8" />
