      type="flash.text.TextFormat"
      stylename="toptoolbar.topBtn.stateText_t1"
      args="Arial,12,0x1de722,,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="toptoolbar.topBtn.stateText_t2"
      args="Arial,12,0xe7b51d,,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="toptoolbar.topBtn.stateText_t3"
      args="Arial,12,0xf70808,,,,,,center" />
