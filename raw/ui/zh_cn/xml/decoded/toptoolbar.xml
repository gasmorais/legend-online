      stylename="toptoolbar.FunnyBtn"
      button="toptoolbar.FunnyMc"
      transparentEnable="true"
      displacement="false"
      tipStyle="yishi.view.tips.OneLineTip"
      isFollowMouse="false"
      tipDirctions="0,3,4"
