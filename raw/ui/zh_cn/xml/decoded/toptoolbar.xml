      tipStyle="yishi.view.tips.OneLineTip"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter" />
    <component
      classname="com.pickgliss.ui.controls.BaseButton"
      stylename="toptoolbar.nextBtn"
      backStyle="toptoolbar.nextBtnBack"
      displacement="true"
      tipStyle="yishi.view.tips.OneLineTip"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter" />
