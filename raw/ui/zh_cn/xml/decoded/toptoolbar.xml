    <component
      classname="yishi.view.component.MovieButton"
      stylename="toptoolbar.topBtn"
      button="toptoolbar.topBtnMc"
      transparentEnable="true"
      displacement="false"
      tipStyle="yishi.view.tips.OneLineTip"
      isFollowMouse="false"
      tipDirctions="0,3,4"
      tipGapH="0"
      tipGapV="0"
      manualHeight="60"
      manualWidth="60"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter" />
