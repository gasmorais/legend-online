      stylename="box.DownBoxImg"
      resourceLink="asset.box.DownBoxImg"
      x="-100"
      y="-90" />
    <component
      classname="com.pickgliss.ui.image.ScaleBitmapImage"
      stylename="bossbox.samllBG"
