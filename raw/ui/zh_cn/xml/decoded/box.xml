      width="175"
      height="59"
      x="0"
      y="0" />
    <component
      classname="yishi.view.community.TimeDownView"
      stylename="timeBox.TimeDown"
      timeTxtStyle="bossbox.downTimeTxt"
      x="-7"
      y="45" />
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="bossbox.downTimeTxt"
      textFormatStyle="noviceBox.format_4,noviceBox.format_5"
      filterString="core.normal_f"
      autoSize="none"
      width="76"
      height="22" />
    <!-- 宝箱掉落 -->
    <component
      classname="com.pickgliss.ui.image.MovieImage"
      stylename="box.waiteBox"
      resourceLink="asset.Box.DownBox" />
    <!-- 时间宝箱界面 -->
    <component
      classname="timebox.TimeBoxFrame"
      stylename="timeBox.TimeBoxFrame"
      parentStyle="core.RoomPasswordFrame"
      width="421"
      height="297"
      containerX="3"
      containerY="9" />
    <component
      classname="com.pickgliss.ui.image.MutipleImage"
      stylename="box.BG"
      resourceLink="asset.box.BG,asset.box.GetBoxTxtImg"
      imageRectString="0|424|0|254|13,40|340|-20|30|13" />
    <!--领取按钮-->
    <component
      classname="com.pickgliss.ui.controls.SelectedIconButton"
      stylename="box.GetRewardBtn"
      unSelectedStyle="asset.box.GetRewardBtnBg"
      selectedStyle="asset.box.GetRewardBtnBg"
      unselectedIconStyle="asset.box.GetLatterTxtImg"
      selectedIconStyle="asset.box.GetRewardTxtImg"
      unselectedIconInnerRectString="8,89,12,18,13"
      selectedIconInnerRectString="8,89,12,18,13"
      filterString="core.DefaultFilter,core.LightFilter,core.DefaultFilter,core.GrayFilter"
      width="106"
      height="44"
      x="152"
      y="208" />
    <!--	倒计时文本	-->
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="box.CountDownTxt"
      textFormatStyle="box.CountDownTxt_t"
      filterString="core.normal_f"
      x="295"
      y="221" />
    <component
      classname="com.pickgliss.ui.text.FilterFrameText"
      stylename="box.CountDownValueTxt"
      textFormatStyle="box.CountDownTxt_t"
      filterString="core.normal_f" />
    <component
      classname="yishi.view.community.TimeDownView"
      stylename="box.CountDownValue"
      timeTxtStyle="box.CountDownValueTxt" />
    <component
      classname="com.pickgliss.ui.image.ScaleBitmapImage"
      stylename="box.GetCountDownBg"
      resourceLink="asset.box.GetCountDownBg"
      scaleGridString="30,5,90,6"
      width="145"
      height="28"
      x="280"
      y="216" />
  </components>
