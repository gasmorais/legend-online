<style
  name="box"
  source="ui/zh_cn/swf/box.swf">
  <sets>
    <set
      type="flash.text.TextFormat"
      stylename="noviceBox.format_4"
      args="Arial,16,0xffde00,,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="noviceBox.format_5"
      args="Arial,16,0xffde00,,,,,,center" />
    <set
      type="flash.text.TextFormat"
      stylename="box.CountDownTxt_t"
      args="Arial,12,0xffebc5" />
  </sets>
  <bitmaps>
    <bitmapData
      resourceLink="asset.box.DownBoxImg" />
    <bitmapData
      resourceLink="asset.timeBox.timeBGAsset"
      x="-7"
      y="43" />
    <bitmapData
      resourceLink="asset.box.GetCountDownBg"
      x="280"
      y="216" />
  </bitmaps>
  <customDisplay>
    <custom
      classname="com.pickgliss.ui.controls.container.SimpleTileList"
      stylename="timeBox.goodsList"
      vSpace="0"
      hSpace="0"
      x="-7"
      y="33" />
    <custom
      classname="flash.display.Sprite"
      stylename="box.downBoxSprite"
      y="-100" />
    <custom
      classname="asset.timebox.TimeBoxMc"
      stylename="timebox.TimeBoxMc" />
  </customDisplay>
  <components>
    <!--时间宝箱按钮-->
    <component
      classname="mainBar.StripView"
      stylename="TimeBox.TimeTip"
      tipStyle="yishi.view.tips.MultipleLineTip"
